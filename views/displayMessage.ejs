<html>
    <body>
        <h1> <%= title %></h1>
        <% messages.forEach((message)=>{ %>
            <ul>
            <li>Text: <%= message.message  %></li>
            <li>User: <%= message.username  %></li>
            <li>Date: <%= message.date  %></li>
            <li><a href= '/message/<%= message.id %>'> View</a></li> 
            </ul>
        <%})%>
        <a href="/new">New Message</a>
    </body>
</html>