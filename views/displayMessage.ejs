<html>
    <body>
        <h1> <%= title %></h1>
        <% messages.forEach((message, index)=>{ %>
            <ul>
            <li>Text: <%= message.text  %></li>
            <li>User: <%= message.user  %></li>
            <li>Date: <%= message.added  %></li>
            <li><a href= '/message/<%= index %>'> View</a></li> 
            </ul>

        <%})%>
        <a href="/new">New Message</a>
    </body>
</html>